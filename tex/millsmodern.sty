\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{millsmodern}[2026/10/03 Mills Modern: letterpress Computer Modern]
% Text: OT1 only (the fonts are generated from Knuth's cm*.mf sources).
\renewcommand\rmdefault{mmr}
\renewcommand\encodingdefault{OT1}
\fontencoding{OT1}\selectfont
% Math.
\DeclareSymbolFont{operators}   {OT1}{mmr}{m}{n}
\DeclareSymbolFont{letters}     {OML}{mmm}{m}{it}
\DeclareSymbolFont{symbols}     {OMS}{mmsy}{m}{n}
\DeclareSymbolFont{largesymbols}{OMX}{mmex}{m}{n}
\SetSymbolFont{operators}{bold}{OT1}{mmr}{bx}{n}
\SetSymbolFont{letters}  {bold}{OML}{mmm}{b}{it}
\SetSymbolFont{symbols}  {bold}{OMS}{mmsy}{b}{n}
\DeclareMathAlphabet{\mathbf}{OT1}{mmr}{bx}{n}
\DeclareMathAlphabet{\mathit}{OT1}{mmr}{m}{it}
\SetMathAlphabet{\mathit}{bold}{OT1}{mmr}{bx}{it}
% Hand-set Monotype math used comparatively large scripts.
\DeclareMathSizes{10}{10}{7}{6}
\DeclareMathSizes{10.95}{10.95}{8}{6}
\DeclareMathSizes{12}{12}{9}{7}
% Hand-set relations were spaced tightly: $u_n<A<v_n$.
\thickmuskip=3.5mu plus 2mu
